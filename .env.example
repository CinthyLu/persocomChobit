# Copia este archivo como ".env" y llena los valores. El .env nunca se sube al repositorio.

# Token que te da @BotFather al crear el bot.
TELEGRAM_TOKEN=

# Tu id numérico de Telegram. Déjalo vacío la primera vez, escribe /id al bot y pega aquí el número.
TELEGRAM_OWNER_ID=

# Clave de la API de Anthropic (console.anthropic.com). Ponle un límite de gasto mensual.
ANTHROPIC_API_KEY=

# Opcionales (estos son los valores por defecto).
# LLM_MODEL=claude-opus-5-5
# ZONA_HORARIA=America/Guayaquil
# DATABASE_URL=sqlite:///asistente.db
